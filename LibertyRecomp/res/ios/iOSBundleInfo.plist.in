<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>

    <key>CFBundleDisplayName</key>
    <string>Liberty Recompiled</string>

    <key>CFBundleExecutable</key>
    <string>${MACOSX_BUNDLE_EXECUTABLE_NAME}</string>

    <key>CFBundleIdentifier</key>
    <string>OZORDI.LibertyRecomp.iOS</string>

    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>

    <key>CFBundleName</key>
    <string>Liberty Recompiled</string>

    <key>CFBundlePackageType</key>
    <string>APPL</string>

    <key>CFBundleShortVersionString</key>
    <string>${MACOSX_BUNDLE_SHORT_VERSION_STRING}</string>

    <key>CFBundleVersion</key>
    <string>${MACOSX_BUNDLE_BUNDLE_VERSION}</string>

    <!-- Minimum iOS version (matches toolchain deployment target) -->
    <key>MinimumOSVersion</key>
    <string>16.0</string>

    <!-- Required capabilities: 64-bit ARM + Metal.
         NOTE: 'gamecontroller' is NOT a valid UIRequiredDeviceCapabilities value
         and was removed. Controller support is advertised via
         GCSupportedGameControllers below. -->
    <key>UIRequiredDeviceCapabilities</key>
    <array>
        <string>arm64</string>
        <string>metal</string>
    </array>

    <!-- Supported device families: 1 = iPhone, 2 = iPad -->
    <key>UIDeviceFamily</key>
    <array>
        <integer>1</integer>
        <integer>2</integer>
    </array>

    <!-- Supported orientations (landscape only for a game) -->
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>
    <key>UISupportedInterfaceOrientations~ipad</key>
    <array>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>

    <!-- Launch screen storyboard -->
    <key>UILaunchStoryboardName</key>
    <string>LaunchScreen</string>

    <!-- Hide status bar -->
    <key>UIStatusBarHidden</key>
    <true/>

    <key>UIViewControllerBasedStatusBarAppearance</key>
    <false/>

    <!-- Full-screen rendering -->
    <key>UIRequiresFullScreen</key>
    <true/>

    <!-- Disable ATS for local LAN game session networking -->
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsLocalNetworking</key>
        <true/>
    </dict>

    <!-- Game Controller framework:
         - GCSupportsControllerUserInteraction lets connected MFi / Xbox / DualShock /
           DualSense controllers drive system UI (e.g. focus navigation) without the app
           needing to handle every event.
         - GCSupportedGameControllers declares the profiles we can consume; we list
           ExtendedGamepad (all modern controllers: Xbox Series, DualShock 4, DualSense,
           MFi Extended) and MicroGamepad (Siri Remote on Apple TV / iPad companion). -->
    <key>GCSupportsControllerUserInteraction</key>
    <true/>
    <key>GCSupportedGameControllers</key>
    <array>
        <dict>
            <key>ProfileName</key>
            <string>ExtendedGamepad</string>
        </dict>
        <dict>
            <key>ProfileName</key>
            <string>MicroGamepad</string>
        </dict>
    </array>

    <!-- Usage descriptions (required by App Store review when the matching APIs
         are linked). Local networking covers LAN session discovery / peer-to-peer
         multiplayer via Bonjour/mDNS, which iOS 14+ gates behind this prompt. -->
    <key>NSLocalNetworkUsageDescription</key>
    <string>Liberty Recompiled uses your local network to discover and connect to nearby players for LAN multiplayer sessions.</string>
    <key>NSBonjourServices</key>
    <array>
        <string>_libertyrecomp._tcp</string>
        <string>_libertyrecomp._udp</string>
    </array>
</dict>
</plist>
