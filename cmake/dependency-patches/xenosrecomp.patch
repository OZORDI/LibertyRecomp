+            entries = []
+            for stage, hash_value, counterpart, source_name, radius in (
+                ("vertex", "0x0000000000000001", "0x0000000000000002", "vertex.hlsl", "0x3F000000"),
+                ("pixel", "0x0000000000000002", "0x0000000000000001", "pixel.hlsl", "0x3F59999A"),
+            ):
+                entries.append(
+                    {
